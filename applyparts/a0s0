import pathlib, sys
root = pathlib.Path(".")
def sub(path, old, new):
    p = root / path
    text = p.read_text() if p.exists() else ""
    if old not in text:
        sys.exit("anchor missing in " + path)
    p.write_text(text.replace(old, new, 1))
